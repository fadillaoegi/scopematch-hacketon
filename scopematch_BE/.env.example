# Copy to .env (gitignored) and fill in. Never commit a real key.
# Optional: enables "Suggest questions with AI" on the setup screen.
GEMINI_API_KEY=
# Optional: comma-separated fallback order; when one model hits its rate limit
# the next is tried. Default: gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.6-flash,gemini-3-flash-preview
GEMINI_MODEL=
